+@pytest.mark.parametrize("num_tokens", [0, 1, 17, 198])
+@pytest.mark.parametrize("use_combine", [False, True])
+def test_hc_fp32_preserves_intermediates(num_tokens, use_combine):
+    """Mix and delayed combine follow an FP32 oracle, including final mixers."""
+    from vllm.models.qwen4_exp.nvidia.ops.hc_fp32 import (
+        hc_combine_fp32,
+        hc_mix_fp32,
+    )
+
+    torch.manual_seed(34)
+    hidden, rank = 128, 16
+    wide = HC * hidden
+    kwargs = dict(device="cuda", dtype=torch.bfloat16)
+    x = torch.randn(num_tokens, wide, **kwargs)
+    norm = torch.randn(wide, **kwargs) * 0.1
+    down = torch.randn(rank, wide, **kwargs) * 0.1
+    up = torch.randn(wide, rank, **kwargs) * 0.1
+    inject = torch.randn(HC, wide, **kwargs) * 0.1 if use_combine else None
+    actual, logits = hc_mix_fp32(x, norm, down, up, inject, HC, EPS)
+    grouped = x.float().reshape(num_tokens, HC, hidden)
+    normed = grouped / (grouped.square().mean(-1, keepdim=True) + EPS).sqrt()
+    normed = normed.reshape(num_tokens, wide) * (1.0 + norm.float())
+    low = torch.nn.functional.silu(
+        torch.nn.functional.linear(normed, down.float()) / HC
+    )
+    gate = torch.sigmoid(torch.nn.functional.linear(low, up.float()))
+    expected = (normed * gate).reshape(num_tokens, HC, hidden).mean(1)
+    torch.testing.assert_close(actual, expected.to(x.dtype))
+    if use_combine:
+        expected_logits = torch.nn.functional.linear(normed, inject.float())
+        assert logits.dtype == torch.float32
+        torch.testing.assert_close(logits, expected_logits, atol=2e-5, rtol=2e-5)
+        coefficient = 2.0 * torch.sigmoid(expected_logits / HC)
+    else:
+        assert logits is None
+        coefficient = torch.ones(num_tokens, HC, device="cuda")
+    block = torch.randn(num_tokens, hidden, **kwargs)
+    combined = hc_combine_fp32(x, block, logits, HC)
+    expected = grouped + coefficient[..., None] * block.float()[:, None]
+    torch.testing.assert_close(combined, expected.reshape(num_tokens, wide).to(x.dtype))
+
+
