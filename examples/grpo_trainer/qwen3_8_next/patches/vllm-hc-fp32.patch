diff --git a/vllm/models/qwen4_exp/nvidia/ops/hc_fp32.py b/vllm/models/qwen4_exp/nvidia/ops/hc_fp32.py
new file mode 100644
index 000000000..d54bf1000
--- /dev/null
+++ b/vllm/models/qwen4_exp/nvidia/ops/hc_fp32.py
@@ -0,0 +1,148 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# Forward kernels adapted from verl's Qwen3.8-Next HC, originally from
+# radixark/miles PR #2777, revision 6aea72c18bd92c35e53e7d02699a01e02de8993f.
+"""HC with FP32 intermediates, matching the Megatron training adapter."""
+
+import torch
+import torch.nn.functional as F
+
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit(do_not_specialize=["T"])
+def _norm_kernel(
+    X,
+    W,
+    Y,
+    T,
+    N: tl.constexpr,
+    C: tl.constexpr,
+    EPS: tl.constexpr,
+    SHARED: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0) // N
+    stream = tl.program_id(0) % N
+    i = tl.arange(0, BLOCK)
+    offset = row * N * C + stream * C + i
+    x = tl.load(X + offset, i < C, other=0).to(tl.float32)
+    w_offset = i if SHARED else stream * C + i
+    w = tl.load(W + w_offset, i < C, other=0).to(tl.float32)
+    rstd = 1.0 / tl.sqrt(tl.sum(x * x, axis=0) / C + EPS)
+    tl.store(Y + offset, x * rstd * (1.0 + w), i < C)
+
+
+@triton.jit(do_not_specialize=["T"])
+def _mix_kernel(X, G, Y, T, N: tl.constexpr, C: tl.constexpr, BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    i = tl.arange(0, BLOCK)
+    acc = tl.zeros([BLOCK], dtype=tl.float32)
+    for stream in tl.static_range(N):
+        offset = row * N * C + stream * C + i
+        x = tl.load(X + offset, i < C, other=0)
+        gate = tl.load(G + offset, i < C, other=0)
+        acc += gate * x
+    tl.store(Y + row * C + i, (acc / N).to(Y.dtype.element_ty), i < C)
+
+
+@triton.jit(do_not_specialize=["T"])
+def _combine_kernel(
+    R,
+    Y,
+    A,
+    OUT,
+    T,
+    N: tl.constexpr,
+    C: tl.constexpr,
+    UNIT: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0) // N
+    stream = tl.program_id(0) % N
+    i = tl.arange(0, BLOCK)
+    offset = row * N * C + stream * C + i
+    r = tl.load(R + offset, i < C, other=0).to(tl.float32)
+    y = tl.load(Y + row * C + i, i < C, other=0).to(tl.float32)
+    a = 1.0 if UNIT else tl.load(A + row * N + stream)
+    tl.store(OUT + offset, (r + a * y).to(OUT.dtype.element_ty), i < C)
+
+
+def hc_mix_fp32(
+    x: torch.Tensor,
+    norm_weight: torch.Tensor,
+    down_weight: torch.Tensor,
+    up_weight: torch.Tensor,
+    inject_weight: torch.Tensor | None,
+    hc_count: int,
+    eps: float,
+) -> tuple[torch.Tensor, torch.Tensor | None]:
+    """Return model-dtype block input and FP32, unscaled injection logits.
+
+    Parameters retain their checkpoint dtype. Casting them on each invocation
+    also observes weights replaced by RL updates without a stale FP32 cache.
+    """
+    x = x.contiguous()
+    tokens, wide = x.shape
+    hidden = wide // hc_count
+    normed = torch.empty_like(x, dtype=torch.float32)
+    mixed = torch.empty(tokens, hidden, dtype=x.dtype, device=x.device)
+    if tokens:
+        _norm_kernel[(tokens * hc_count,)](
+            x,
+            norm_weight,
+            normed,
+            tokens,
+            hc_count,
+            hidden,
+            eps,
+            norm_weight.numel() == hidden,
+            triton.next_power_of_2(hidden),
+        )
+    down = F.linear(normed, down_weight.float()) / hc_count
+    gate = torch.sigmoid(F.linear(F.silu(down), up_weight.float()))
+    if tokens:
+        _mix_kernel[(tokens,)](
+            normed,
+            gate,
+            mixed,
+            tokens,
+            hc_count,
+            hidden,
+            triton.next_power_of_2(hidden),
+        )
+    injection = (
+        F.linear(normed, inject_weight.float()) if inject_weight is not None else None
+    )
+    return mixed, injection
+
+
+def hc_combine_fp32(
+    residual: torch.Tensor,
+    block_output: torch.Tensor,
+    injection: torch.Tensor | None,
+    hc_count: int,
+) -> torch.Tensor:
+    """Consume unscaled logits and round the updated residual to its dtype."""
+    residual, block_output = residual.contiguous(), block_output.contiguous()
+    tokens, wide = residual.shape
+    hidden = wide // hc_count
+    out = torch.empty_like(residual)
+    coefficient = (
+        2.0 * torch.sigmoid(injection.float() / hc_count)
+        if injection is not None
+        else None
+    )
+    if tokens:
+        _combine_kernel[(tokens * hc_count,)](
+            residual,
+            block_output,
+            coefficient,
+            out,
+            tokens,
+            hc_count,
+            hidden,
+            coefficient is None,
+            triton.next_power_of_2(hidden),
+        )
+    return out
