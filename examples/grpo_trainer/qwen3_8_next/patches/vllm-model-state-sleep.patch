+@pytest.mark.parametrize("sleep_enabled", [False, True])
+def test_model_state_initialization_keeps_runtime_ownership(monkeypatch, sleep_enabled):
+    """State uses retained memory; disabled sleep leaves the allocator idle."""
+    from contextlib import contextmanager
+    from types import SimpleNamespace
+
+    from vllm.v1.worker.gpu import model_states
+
+    active = ["weights"]
+
+    @contextmanager
+    def use_pool(*, tag):
+        active.append(tag)
+        try:
+            yield
+        finally:
+            active.pop()
+
+    class State:
+        def __init__(self, config, model, encoder_cache, device):
+            self.tag = active[-1]
+
+    def allocator():
+        assert sleep_enabled, "Disabled sleep must not initialize the allocator"
+        return SimpleNamespace(use_memory_pool=use_pool)
+
+    monkeypatch.setattr(model_states, "get_mem_allocator_instance", allocator)
+    config = SimpleNamespace(
+        model_config=SimpleNamespace(
+            enable_sleep_mode=sleep_enabled, enable_prompt_embeds=False
+        )
+    )
+    state = model_states.init_model_state(
+        config, SimpleNamespace(get_model_state_cls=lambda: State), None, None
+    )
+    assert state.tag == ("runtime" if sleep_enabled else "weights")
+    assert active == ["weights"]
+
